{
  "name": "moosify-website",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "type": "module",
  "scripts": {
    "start": "node -r dotenv/config server.mjs",
    "static": "python3 -m http.server 4173",
    "sync-pages": "node scripts/sync-pages.mjs",
    "dev": "npx wrangler dev",
    "publish": "npx wrangler deploy",
    "deploy": "./scripts/deploy.sh",
    "db:setup": "./scripts/setup-d1.sh",
    "db:local": "npx wrangler d1 migrations apply moosify --local",
    "test": "node --test tests/*.test.mjs"
  }
}
